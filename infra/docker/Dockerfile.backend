# =============================================================================
# Sentinel Backend — Dockerfile
# Multi-stage, multi-architecture build for AMD64 and ARM64.
# =============================================================================

# ---- Stage 1: Builder -------------------------------------------------------
FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /build
COPY requirements.txt ./

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ---- Stage 2: Runtime -------------------------------------------------------
FROM python:3.12-slim AS runtime

# Install the runtime PostgreSQL client library through Debian so the correct
# architecture-specific path is selected for both AMD64 and ARM64 images.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN groupadd --gid 1001 sentinel && \
    useradd --uid 1001 --gid sentinel --no-create-home --shell /bin/false sentinel

WORKDIR /app
COPY --chown=sentinel:sentinel . /app/

# Build-only settings are scoped to this command and are not persisted in the
# final image configuration.
RUN DJANGO_SETTINGS_MODULE=config.settings \
    SECRET_KEY=build-time-dummy-key-not-used-at-runtime-sentinel-x \
    DATABASE_URL=postgres://x:x@localhost:5432/x \
    REDIS_URL=redis://localhost:6379/0 \
    OTEL_ENABLED=False \
    CELERY_BROKER_URL=redis://localhost:6379/1 \
    CELERY_RESULT_BACKEND=redis://localhost:6379/2 \
    python -m django collectstatic --noinput --verbosity 0

USER sentinel

# Health check via Python stdlib — no curl dependency
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health/live/')" || exit 1

EXPOSE 8000

CMD ["gunicorn", \
     "config.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "4", \
     "--worker-class", "sync", \
     "--worker-connections", "1000", \
     "--timeout", "60", \
     "--keepalive", "5", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--log-level", "warning"]
